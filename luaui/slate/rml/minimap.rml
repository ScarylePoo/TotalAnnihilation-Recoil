<rml>
<head>
	<title>Slate minimap frame</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* A Slate frame around the engine's minimap. The engine draws the
		   minimap underneath (before RmlUi), so the frame is hollow: a light
		   outer line, a band of the theme's glass and a light inner line, no
		   background. It never takes the mouse. Position and size are set
		   from Lua to wrap whatever geometry the minimap has (the player can
		   resize it in the settings; the engine may move it). The band's
		   colour follows the opacity and tint settings (set from Lua). */
		#minimap-frame {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100px;
			height: 100px;
			box-sizing: border-box;
			border: 1dp rgba(255, 255, 255, 36);
			border-radius: 8dp;
		}
		#minimap-glass {
			width: 100%;
			height: 100%;
			box-sizing: border-box;
			border: 6dp rgba(13, 14, 16, 224);
			border-radius: 7dp;
		}
		#minimap-line {
			width: 100%;
			height: 100%;
			box-sizing: border-box;
			border: 1dp rgba(255, 255, 255, 50);
			border-radius: 2dp;
		}
	</style>
</head>
<body>
	<div id="minimap-frame">
		<div id="minimap-glass">
			<div id="minimap-line"/>
		</div>
	</div>
</body>
</rml>
