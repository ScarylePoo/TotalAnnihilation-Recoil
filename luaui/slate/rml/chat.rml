<rml>
<head>
	<title>Slate chat</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		/* The newest chat lines, low in the middle of the screen. They fade
		   out by themselves and never take the mouse; the whole history is in
		   the Log window. The box's position is set from Lua (hud.PlacePanel);
		   its size here must match BOX_WIDTH and BOX_HEIGHT in
		   slate_chat.lua. Lines sit at the bottom of the box and grow up. */
		#chat {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 650dp;
			height: 200dp;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			align-items: flex-start; /* a line is as wide as its text, not as the box */
			overflow: hidden;
		}
		/* A line is laid over the map with nothing behind it, so it carries
		   its own dark backing and a bar in its channel's color. */
		.line {
			margin-top: 3dp;
			padding: 3dp 10dp 4dp 9dp;
			font-size: 17dp;
			line-height: 22dp;
			color: #f4f5f7;
			background-color: rgba(11, 14, 18, 170);
			border-left: 2dp rgba(255,255,255,60);
			font-effect: shadow(1dp 1dp #000000);
		}
		.name {
			font-weight: bold;
		}
		.line.ally { color: #9be7a8; border-left: 2dp #9be7a8; }
		.line.marker { color: #9be7a8; border-left: 2dp #9be7a8; }
		.line.whisper { color: #ff7366; border-left: 2dp #ff7366; }
		.line.spectator { color: #f2d64b; border-left: 2dp #f2d64b; }
		.line.event { color: #a9bdd0; border-left: 2dp #a9bdd0; }
		.line.system { color: #b5bac1; }
		/* a player's game out of sync: the most serious line there is */
		.line.desync {
			color: #ffb3ac;
			background-color: rgba(70, 14, 12, 215);
			border-left: 4dp #ffb3a6;
		}
		.line.warning { color: #a9bdd0; border-left: 2dp #a9bdd0; }
	</style>
</head>
<body>
	<div id="chat"/>
</body>
</rml>
